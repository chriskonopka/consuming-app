{
  "routes": [
    {
      "route": "/version.json",
      "headers": {
        "Cache-Control": "no-store"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/*.{js,mjs,css,map,json,wasm,ico,png,jpg,jpeg,gif,svg,woff,woff2,ttf,eot}",
      "/pdfjs/*",
      "/assets/*"
    ]
  },
  "mimeTypes": {
    ".mjs": "text/javascript"
  }
}
